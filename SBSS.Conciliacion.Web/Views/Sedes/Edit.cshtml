@model EditarSedeVm
@{
    ViewData["Title"] = "Editar sede";
}

<div class="wrap page-head"><h1>Editar sede</h1></div>

<div class="wrap">
    <div class="panel" style="max-width:600px;">
        <form asp-action="Edit" method="post" class="form-sbss">
            <input type="hidden" asp-for="IdSede" />
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <label asp-for="Nombre"></label>
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre" class="text-danger"></span>

            <label asp-for="Descripcion"></label>
            <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>

            <div style="display:flex;gap:12px;">
                <button type="submit" class="btn btn-primary">Guardar cambios</button>
                <a asp-action="Index" class="btn btn-ghost">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
