@model RegistrarResultadoVm
@{
    ViewData["Title"] = "Registrar resultado de audiencia";
}

<div class="wrap page-head"><h1>Registrar resultado de la audiencia</h1></div>

<div class="wrap">
    <div class="panel" style="max-width:640px;">
        <form asp-action="RegistrarResultado" method="post" class="form-sbss">
            <input type="hidden" asp-for="IdDocumento" />
            <input type="hidden" asp-for="IdExpediente" />
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <label asp-for="Resultado"></label>
            <select asp-for="Resultado" class="form-control">
                <option value="">-- Selecciona --</option>
                <option value="ACUERDO_TOTAL">Acuerdo total</option>
                <option value="ACUERDO_PARCIAL">Acuerdo parcial</option>
                <option value="NO_ACUERDO">No hubo acuerdo</option>
                <option value="INASISTENCIA_AMBAS">Inasistencia de ambas partes</option>
                <option value="INASISTENCIA_UNA">Inasistencia de una parte</option>
            </select>
            <span asp-validation-for="Resultado" class="text-danger"></span>

            <label asp-for="Observaciones"></label>
            <textarea asp-for="Observaciones" class="form-control" rows="4"></textarea>

            <button type="submit" class="btn btn-primary">Guardar resultado</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
