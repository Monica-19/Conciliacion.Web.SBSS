@{
    ViewData["Title"] = "Error";
}
<section class="wrap" style="padding:80px 0;text-align:center;">
    <h1>Ocurrió un error</h1>
    <p style="color:#4a5a61;">Lo sentimos, algo no salió como esperábamos.</p>
    @if (Model is string requestId && !string.IsNullOrEmpty(requestId))
    {
        <p><small>Request ID: <code>@requestId</code></small></p>
    }
    @if (User.Identity is { IsAuthenticated: true })
    {
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary" style="margin-top:20px;">Volver al Dashboard</a>
    }
    else
    {
        <a asp-controller="Account" asp-action="Login" class="btn btn-primary" style="margin-top:20px;">Volver al inicio de sesión</a>
    }
</section>
